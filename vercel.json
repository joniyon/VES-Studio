{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web", "framework": "nextjs" },
    "geophysics-api": {
      "root": "services/geophysics-api",
      "framework": "fastapi",
      "entrypoint": "app.api.main:app",
      "routes": [
        { "src": "/api/(.*)", "transforms": [{ "type": "request.path", "op": "set", "args": "/$1" }] }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "geophysics-api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
